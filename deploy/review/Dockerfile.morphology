# Build after the regular review image. Model weights live in a separate volume.
FROM ai-spine-review:v13

USER root
ARG DISC_CLI_COMMIT=80d2aeff96b044aa9e0f1c585a6a0de73554c53c
ARG SPINESEGPLUS_COMMIT=66fd963b4e7e4f9530e6cf7b983b23348712dcab

RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates libgomp1 \
    && rm -rf /var/lib/apt/lists/*

RUN python -m venv /opt/disc-cli \
    && /opt/disc-cli/bin/pip install --no-cache-dir \
       "git+https://github.com/ndreuu/disc-morphology-cli.git@${DISC_CLI_COMMIT}"

RUN git init /opt/disc-source \
    && git -C /opt/disc-source remote add origin https://github.com/Albertzry/SpineSegPlus.git \
    && git -C /opt/disc-source fetch --depth 1 origin "${SPINESEGPLUS_COMMIT}" \
    && git -C /opt/disc-source checkout --detach FETCH_HEAD \
    && test "$(git -C /opt/disc-source rev-parse HEAD)" = "${SPINESEGPLUS_COMMIT}"

# nnU-Net has its own NumPy/PyTorch requirements, separate from the review app.
RUN python -m venv /opt/disc-runtime \
    && /opt/disc-runtime/bin/pip install --no-cache-dir \
       torch==2.5.1 torchvision==0.20.1 --index-url https://download.pytorch.org/whl/cpu \
    && /opt/disc-runtime/bin/pip install --no-cache-dir \
       numpy==2.2.6 nnunetv2==2.4.2 dynamic_network_architectures==0.3.1 \
       -e /opt/disc-source \
    && /opt/disc-runtime/bin/python -c \
       'import torch,numpy,nnunetv2,nibabel,SimpleITK; assert torch.__version__.split("+")[0] == "2.5.1"' \
    && chown -R 1000:1000 /opt/disc-source

ENV DISC_MORPHOLOGY_MODEL_HOME=/disc-models

# Provision a writable /disc-models volume once with the CLI setup command,
# using --python /opt/disc-runtime/bin/python --source /opt/disc-source.
USER 1000:1000
